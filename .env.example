# -----------------------------------------------------------------------------
# Required for real AI responses
# Get a key at https://platform.deepseek.com/
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# Optional — defaults shown
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# ENABLE_REASONER=true

# auto = demo only when DEEPSEEK_API_KEY is missing; on = force demo; off = require key
DEMO_MODE=auto

# local    = scripted demo reply (default, privacy-friendly)
# pollinations = free public demo endpoint (sends chat text to a third party)
DEMO_PROVIDER=local
# DEMO_MODEL=openai-fast

# Server
PORT=8787
# SYSTEM_PROMPT=你是「墨语」……
MAX_INPUT_CHARS=40000
MAX_OUTPUT_TOKENS=4096
UPSTREAM_TIMEOUT_MS=120000

# Abuse protection (per IP, in-memory; use a shared store for multi-instance)
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=240
