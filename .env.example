# -----------------------------------------------------------------------------
# DeepSeek via the Anthropic-compatible Messages API (current setup)
# Get a key at https://platform.deepseek.com/
# -----------------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_MODEL_NAME=V4 Pro
ANTHROPIC_FAST_MODEL=deepseek-flash
ANTHROPIC_FAST_MODEL_NAME=V4.1 Flash

# -----------------------------------------------------------------------------
# Optional: OpenAI-compatible provider instead of Anthropic
# Set AI_PROVIDER=openai and fill DEEPSEEK_API_KEY.
# -----------------------------------------------------------------------------
# AI_PROVIDER=openai
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# auto = demo only when the API key is missing; on = force demo; off = require key
DEMO_MODE=auto

# local    = scripted demo reply (privacy-friendly)
# pollinations = free public demo endpoint (sends chat text to a third party)
DEMO_PROVIDER=local
# DEMO_MODEL=openai-fast

# Server
PORT=8787
# SYSTEM_PROMPT=你是「墨语」……
MAX_INPUT_CHARS=40000
MAX_OUTPUT_TOKENS=8192
UPSTREAM_TIMEOUT_MS=120000

# Set to false to show only the first model in the picker.
ENABLE_SECOND_MODEL=true

# Abuse protection (per IP, in-memory; use a shared store for multi-instance)
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=240
